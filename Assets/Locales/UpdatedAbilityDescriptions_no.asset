  m_SharedData: {fileID: 11400000, guid: d4796c32e9219d742a267c25e6354633, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 78470532214784
    m_Localized: "Frys fiender inn til margen slik at de ikke kan bevege seg eller
      angripe p\xE5 en kort stund. En frossen fiende som dyttes in i en vegg vil
      KNUSES, og blir p\xE5f\xF8rt d\xF8delig skade."
    m_Metadata:
      m_Items: []
  - m_Id: 78528635908096
    m_Localized: "\xC5 fryse en svak fiende vil KNUSE den ummidelbart, og henretter
      fienden. Terskelen for henrettelser \xF8ker i samsvar med level. Ganske kj\xF8lig!"
    m_Metadata:
      m_Items: []
  - m_Id: 78550739890176
    m_Localized: "Etterlat en etsende myr som tapper helsen til enhver fiende dum
      nok til \xE5 g\xE5 uti."
    m_Metadata:
      m_Items: []
  - m_Id: 78578443268096
    m_Localized: "Giften vedvarer etter en fiende har forlatt det p\xE5virkede omr\xE5det,
      og skaden \xF8ker i samsvar med level. Gj\xF8r slutt p\xE5 lidelsene deres..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
