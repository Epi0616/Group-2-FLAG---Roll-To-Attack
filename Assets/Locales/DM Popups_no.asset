  m_TableData:
  - m_Id: 1250098851840
    m_Localized: Lyden av mange bein fyller arenaen, dette er edderkoppenes territorium!
    m_Metadata:
      m_Items: []
  - m_Id: 96174518272
    m_Localized: "Vokterens tjenere gj\xF8r seg synlige!"
    m_Metadata:
      m_Items: []
  - m_Id: 469866033152
    m_Localized: "Bakken sv\xF8mmer idet Sandhaier kommer til syne!"
    m_Metadata:
      m_Items: []
  - m_Id: 666255929344
    m_Localized: "Spyttere er p\xE5 jakt!"
    m_Metadata:
      m_Items: []
  - m_Id: 559166959616
    m_Localized: En lav rumling idet Golemer reiser seg!
    m_Metadata:
      m_Items: []
  - m_Id: 1093802307584
    m_Localized: "F\xF8lg godt med, avstandsfiender str\xF8mmer inn i arenaen!"
    m_Metadata:
      m_Items: []
  - m_Id: 932606816256
    m_Localized: "Fortiden n\xE6rmer seg, Originale fiender str\xF8mmer inn i arenaen!"
    m_Metadata:
      m_Items: []
  - m_Id: 816835637248
    m_Localized: "Hold avstand, n\xE6rkampfiender str\xF8mmer inn i arenaen!"
    m_Metadata:
      m_Items: []
