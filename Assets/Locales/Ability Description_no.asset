  m_TableData:
  - m_Id: 5255081984
    m_Localized: "Gj\xF8r skade"
    m_Metadata:
      m_Items: []
  - m_Id: 698305097728
    m_Localized: "Fryser fiendter p\xE5 plass en kort stund"
    m_Metadata:
      m_Items: []
  - m_Id: 869793411072
    m_Localized: Dytter fiender vekk fra spilleren
    m_Metadata:
      m_Items: []
  - m_Id: 1054967738368
    m_Localized: "Lager et felt som gj\xF8r skade over tid"
    m_Metadata:
      m_Items: []
  - m_Id: 1205874601984
    m_Localized: "Skyter raketter som regner ned p\xE5 fiendter"
    m_Metadata:
      m_Items: []
  - m_Id: 1419075268608
    m_Localized: Senker farten til fiender
    m_Metadata:
      m_Items: []
  - m_Id: 1605155565568
    m_Localized: "Lager orbitale pigger som gj\xF8r skade ved kontakt"
    m_Metadata:
      m_Items: []
  - m_Id: 1813696360448
    m_Localized: Lager en mine som drar inn fiendter ved detonering
    m_Metadata:
      m_Items: []
  - m_Id: 2117150060544
    m_Localized: Fiender tar mer skade
    m_Metadata:
      m_Items: []
