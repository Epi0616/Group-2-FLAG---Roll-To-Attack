  m_TableData:
  - m_Id: 5255081984
    m_Localized: "Verursacht Sch\xE4den"
    m_Metadata:
      m_Items: []
  - m_Id: 698305097728
    m_Localized: "Friert Gegner f\xFCr kurze Zeit an Ort und Stelle ein"
    m_Metadata:
      m_Items: []
  - m_Id: 869793411072
    m_Localized: Schleudert Gegner vom Spieler weg
    m_Metadata:
      m_Items: []
  - m_Id: 1054967738368
    m_Localized: Erzeugt ein Feld, das im Laufe der Zeit Schaden verursacht
    m_Metadata:
      m_Items: []
  - m_Id: 1205874601984
    m_Localized: Feuert Raketen ab, die auf die Feinde herabregnen
    m_Metadata:
      m_Items: []
  - m_Id: 1419075268608
    m_Localized: Verringert die Bewegungsgeschwindigkeit von Feinden
    m_Metadata:
      m_Items: []
  - m_Id: 1605155565568
    m_Localized: Erzeugt orbitale Spitzen, die bei Kontakt Schaden verursachen
    m_Metadata:
      m_Items: []
  - m_Id: 1813696360448
    m_Localized: Erzeugt eine Mine, die bei Detonation Feinde anzieht
    m_Metadata:
      m_Items: []
  - m_Id: 2117150060544
    m_Localized: "F\xFChrt dazu, dass Gegner mehr Schaden erleiden"
    m_Metadata:
      m_Items: []
